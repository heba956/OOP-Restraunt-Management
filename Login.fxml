<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="projecttry1.LoginController">
   <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
   </padding>
   <children>
      <Label text="Welcome Back" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
      <TextField fx:id="usernameField" promptText="Username" maxWidth="260.0" />
      <PasswordField fx:id="passwordField" promptText="Password" maxWidth="260.0" />
      <Button text="Log In" onAction="#handleLogin" defaultButton="true" />
      <Label fx:id="messageLabel" wrapText="true" maxWidth="260.0" />
      <Hyperlink text="Don't have an account? Register here" onAction="#goToRegister" />
   </children>
</VBox>
