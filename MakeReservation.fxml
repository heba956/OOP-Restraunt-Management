<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="601.0" prefWidth="706.0" spacing="0" style="-fx-background-color: white;"
      BorderPane.alignment="CENTER" xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="projecttry1.MakeReservationController">
    <children>

        <!-- HEADER -->
        <ImageView fitHeight="80.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@logo.jpeg" />
            </image>
            <VBox.margin>
                <Insets bottom="10.0" left="30.0" right="30.0" top="20.0" />
            </VBox.margin>
        </ImageView>

        <Label style="-fx-font-weight: bold; -fx-font-size: 20;" text="Make a Reservation">
            <VBox.margin>
                <Insets bottom="20.0" left="30.0" />
            </VBox.margin>
            <font>
                <Font name="Baskerville Old Face" size="20.0" />
            </font>
        </Label>

        <!-- FORM CARD -->
        <VBox alignment="CENTER_LEFT" spacing="14" style="-fx-background-color: #F5EFE6; -fx-background-radius: 10; -fx-padding: 20;">
            <VBox.margin>
                <Insets bottom="16.0" left="30.0" right="30.0" />
            </VBox.margin>
            <children>

                <VBox spacing="4">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 12;" text="Date" />
                    <DatePicker fx:id="datePicker" maxWidth="Infinity" style="-fx-background-radius: 6;" />
                </VBox>

                <VBox spacing="4">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 12;" text="Time" />
                    <ComboBox fx:id="timeComboBox" maxWidth="Infinity" promptText="Select a time" style="-fx-background-radius: 6;" />
                </VBox>

                <VBox spacing="4">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 12;" text="Party Size" />
                    <Spinner fx:id="partySizeSpinner" editable="true" maxWidth="Infinity" style="-fx-background-radius: 6;" />
                </VBox>

                <VBox spacing="4">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 12;" text="Table" />
                    <ComboBox fx:id="tableComboBox" maxWidth="Infinity" promptText="Select a table" style="-fx-background-radius: 6;" />
                </VBox>

                <Label fx:id="statusLabel" style="-fx-text-fill: #df521a; -fx-font-weight: bold; -fx-font-size: 12;" text="" wrapText="true" />

            </children>
        </VBox>

        <!-- SPACER pushes buttons to bottom -->
        <VBox VBox.vgrow="ALWAYS" />

        <!-- ACTION BUTTONS -->
        <HBox alignment="CENTER" spacing="12">
            <VBox.margin>
                <Insets bottom="30.0" left="30.0" right="30.0" />
            </VBox.margin>
            <children>
                <Button fx:id="cancelButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleCancel"
                        style="-fx-background-color: #CBBFAF; -fx-background-radius: 8; -fx-font-weight: bold;" text="Cancel" HBox.hgrow="ALWAYS">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Button>

                <Button fx:id="confirmButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleConfirm"
                        style="-fx-background-color: #df521a; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold;" text="Confirm Reservation" HBox.hgrow="ALWAYS">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Button>
            </children>
        </HBox>

    </children>
</VBox>
