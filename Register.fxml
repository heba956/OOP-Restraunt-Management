<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="projecttry1.RegisterController">
   <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
   </padding>
   <children>
      <Label text="Create an Account" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
      <TextField fx:id="usernameField" promptText="Username" maxWidth="260.0" />
      <PasswordField fx:id="passwordField" promptText="Password (min 6 characters)" maxWidth="260.0" />
      <DatePicker fx:id="dobPicker" promptText="Date of birth" maxWidth="260.0" />
      <TextField fx:id="phoneField" promptText="Phone number (11 digits)" maxWidth="260.0" />
      <TextField fx:id="dietaryField" promptText="Dietary preferences" maxWidth="260.0" />
      <Button text="Register" onAction="#handleRegister" defaultButton="true" />
      <Label fx:id="messageLabel" wrapText="true" maxWidth="260.0" />
      <Hyperlink text="Already have an account? Log in" onAction="#goToLogin" />
   </children>
</VBox>
