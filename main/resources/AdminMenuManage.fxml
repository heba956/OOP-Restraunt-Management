<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="700.0" prefWidth="920.0" spacing="14.0"
      style="-fx-background-color: #f0f2f5;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="projecttry1.AdminMenuManageController">
   <padding><Insets bottom="24.0" left="30.0" right="30.0" top="24.0" /></padding>
   <children>

      <!-- Header -->
      <HBox alignment="CENTER_LEFT" spacing="12">
         <ImageView fitHeight="40" fitWidth="100" preserveRatio="true">
            <image><Image url="@logo.jpeg" /></image>
         </ImageView>
         <Label text="🍽️ Manage Menu Items"
                style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
         <Region HBox.hgrow="ALWAYS" />
         <Button text="← Back to Dashboard" styleClass="secondary-button" onAction="#handleBack" />
      </HBox>

      <!-- Main content -->
      <HBox spacing="14.0" VBox.vgrow="ALWAYS">

         <!-- Left: Table of items -->
         <VBox spacing="8.0" HBox.hgrow="ALWAYS"
               style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 16;
                      -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 6, 0, 0, 2);">
            <Label text="All Menu Items"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
            <Label text="Click a row to load it into the form."
                   style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;" />
            <TableView fx:id="menuTable" VBox.vgrow="ALWAYS" onMouseClicked="#handleSelectItem">
               <columns>
                  <TableColumn fx:id="colName"  text="Name"      prefWidth="150" />
                  <TableColumn fx:id="colPrice" text="Price"     prefWidth="80"  />
                  <TableColumn fx:id="colCat"   text="Category"  prefWidth="120" />
                  <TableColumn fx:id="colAvail" text="Available" prefWidth="80"  />
               </columns>
            </TableView>
         </VBox>

         <!-- Right: Form -->
         <VBox spacing="10.0" prefWidth="310.0"
               style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                      -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 6, 0, 0, 2);">
            <Label text="Add / Edit Item"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

            <Label text="Name:" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
            <TextField fx:id="nameField" promptText="Item name" styleClass="text-field" />

            <Label text="Price (EGP):" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
            <TextField fx:id="priceField" promptText="e.g. 99.0" styleClass="text-field" />

            <Label text="Description:" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
            <TextArea fx:id="descField" promptText="Short description" prefRowCount="3"
                      style="-fx-background-radius: 8; -fx-border-radius: 8;
                             -fx-border-color: #bdc3c7; -fx-padding: 6;" />

            <Label text="Category:" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
            <ComboBox fx:id="categoryCombo" promptText="Select category"
                      maxWidth="Infinity" styleClass="combo-box" />

            <CheckBox fx:id="availableCheck" text="Available" selected="true"
                      style="-fx-font-weight: bold;" />

            <HBox spacing="8.0">
               <Button text="Add" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                       styleClass="primary-button" onAction="#handleAdd" />
               <Button text="Update" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                       styleClass="secondary-button" onAction="#handleUpdate" />
               <Button text="Delete" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                       styleClass="danger-button" onAction="#handleDelete" />
            </HBox>

            <Button text="Clear Form" maxWidth="Infinity"
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                    onAction="#handleClearForm" />

            <Label fx:id="feedbackLabel" wrapText="true"
                   style="-fx-font-size: 12px; -fx-font-weight: bold;" />
         </VBox>
      </HBox>
   </children>
</VBox>
