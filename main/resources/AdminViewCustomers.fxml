<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="680.0" prefWidth="860.0" spacing="14.0"
      style="-fx-background-color: #f0f2f5;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="projecttry1.AdminViewCustomersController">
   <padding>
      <Insets bottom="24.0" left="30.0" right="30.0" top="24.0" />
   </padding>
   <children>

      <!-- Header -->
      <HBox alignment="CENTER_LEFT" spacing="12">
         <ImageView fitHeight="40" fitWidth="100" preserveRatio="true">
            <image><Image url="@logo.jpeg" /></image>
         </ImageView>
         <VBox spacing="2.0">
            <Label text="👥 Registered Customers"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
            <Label text="View and monitor all customer accounts."
                   style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" />
         </VBox>
         <Region HBox.hgrow="ALWAYS" />
         <Button text="← Back to Dashboard" styleClass="secondary-button" onAction="#handleBack" />
      </HBox>

      <!-- Stats row -->
      <HBox spacing="12.0">
         <VBox alignment="CENTER" spacing="4.0" HBox.hgrow="ALWAYS"
               style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12;
                      -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 6, 0, 0, 2);">
            <Label fx:id="totalCustomersLabel" text="0"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #e67e22;" />
            <Label text="Total Customers" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;" />
         </VBox>
         <VBox alignment="CENTER" spacing="4.0" HBox.hgrow="ALWAYS"
               style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12;
                      -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 6, 0, 0, 2);">
            <Label fx:id="totalBalanceLabel" text="\$0.00"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" />
            <Label text="Total Customer Balances" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;" />
         </VBox>
         <VBox alignment="CENTER" spacing="4.0" HBox.hgrow="ALWAYS"
               style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12;
                      -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 6, 0, 0, 2);">
            <Label fx:id="totalLoyaltyLabel" text="0 pts"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #3498db;" />
            <Label text="Total Loyalty Points" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;" />
         </VBox>
      </HBox>

      <!-- Customer Table -->
      <VBox spacing="8.0" VBox.vgrow="ALWAYS"
            style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 16;
                   -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 6, 0, 0, 2);">
         <Label text="📋 Customer Directory"
                style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

         <TableView fx:id="customerTable" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="colUsername" text="Username" prefWidth="130" />
               <TableColumn fx:id="colPhone"    text="Phone Number" prefWidth="120" />
               <TableColumn fx:id="colBalance"  text="Balance ($)" prefWidth="100" />
               <TableColumn fx:id="colLoyalty"  text="Loyalty Points" prefWidth="110" />
               <TableColumn fx:id="colDietary"  text="Dietary Preferences" prefWidth="170" />
               <TableColumn fx:id="colDOB"      text="Date of Birth" prefWidth="110" />
            </columns>
         </TableView>
      </VBox>

   </children>
</VBox>
