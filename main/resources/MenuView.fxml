<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="800.0" style="-fx-background-color: #f8f9fa;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="projecttry1.MenuController">

   <top>
      <VBox spacing="12" style="-fx-padding: 20; -fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 4, 0, 0, 1);">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="12">
                     <children>
                        <ImageView fitHeight="40" fitWidth="100" preserveRatio="true">
                           <image><Image url="@logo.jpeg" /></image>
                        </ImageView>
                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Menu Browsing &amp; Order" />
                     </children>
                  </HBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button onAction="#handleBack" styleClass="secondary-button" text="Back to Dashboard" />
               </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="15">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #34495e;" text="Filter Category:" />
                  <ComboBox fx:id="categoryFilter" prefWidth="180.0" promptText="All Categories" styleClass="combo-box" />
                  <Button onAction="#filterMenu" styleClass="primary-button" text="Filter" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>

   <center>
      <VBox spacing="10" style="-fx-padding: 15;">
         <children>
            <TableView fx:id="menuTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="imageColumn" prefWidth="90.0" text="" />
                  <TableColumn fx:id="nameColumn" prefWidth="170.0" text="Item Name" />
                  <TableColumn fx:id="descriptionColumn" prefWidth="240.0" text="Description" />
                  <TableColumn fx:id="priceColumn" prefWidth="90.0" text="Price" />
                  <TableColumn fx:id="categoryColumn" prefWidth="110.0" text="Category" />
                  <TableColumn fx:id="availableColumn" prefWidth="90.0" text="Available" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </center>

   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="20" style="-fx-padding: 18; -fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 4, 0, 0, -1);">
         <children>
            <Label fx:id="feedbackLabel" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2980b9;" text="Select an item to add to your order." />
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="8">
               <children>
                  <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Current Order Total:" />
                  <Label fx:id="totalLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" text="0.00" />
               </children>
            </HBox>
            <Button onAction="#addToOrder" styleClass="primary-button" style="-fx-font-size: 14px;" text="🛒  Add to Order" />
         </children>
      </HBox>
   </bottom>

</BorderPane>
