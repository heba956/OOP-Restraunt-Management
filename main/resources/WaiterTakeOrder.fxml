<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="720.0" prefWidth="960.0" spacing="14.0"
      style="-fx-background-color: #f0f2f5;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="projecttry1.WaiterTakeOrderController">
   <padding>
      <Insets bottom="20.0" left="28.0" right="28.0" top="20.0" />
   </padding>
   <children>

      <!-- Header -->
      <HBox alignment="CENTER_LEFT" spacing="12">
         <ImageView fitHeight="40" fitWidth="100" preserveRatio="true">
            <image><Image url="@logo.jpeg" /></image>
         </ImageView>
         <VBox spacing="2.0">
            <Label text="📝 Take New Order"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
            <Label text="Select a table, pick menu items, and place the customer's order."
                   style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" />
         </VBox>
         <Region HBox.hgrow="ALWAYS" />
         <Button text="← Back to Waiter Dashboard" styleClass="secondary-button" onAction="#handleBack" />
      </HBox>

      <!-- Table & Customer selection bar -->
      <HBox spacing="16.0" alignment="CENTER_LEFT"
            style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 14 18;
                   -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 6, 0, 0, 2);">
         <Label text="🪑 Table:" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #2c3e50;" />
         <ComboBox fx:id="tableCombo" promptText="Select Table" prefWidth="220" styleClass="combo-box" />

         <Label text="👤 Customer:" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #2c3e50;" />
         <ComboBox fx:id="customerCombo" promptText="Select Customer" prefWidth="220" styleClass="combo-box" />

         <Region HBox.hgrow="ALWAYS" />
         <Label text="🍽️ Waiter Order Entry"
                style="-fx-background-color: #fef5ec; -fx-text-fill: #e67e22; -fx-padding: 4 12;
                       -fx-background-radius: 15; -fx-font-weight: bold; -fx-font-size: 12px;" />
      </HBox>

      <!-- Main split: Menu list on left, Order draft on right -->
      <HBox spacing="14.0" VBox.vgrow="ALWAYS">

         <!-- Left: Menu Items selection -->
         <VBox spacing="10.0" HBox.hgrow="ALWAYS"
               style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 16;
                      -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 6, 0, 0, 2);">
            <Label text="🍴 Available Menu Items"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

            <TableView fx:id="menuTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colItemName"  text="Item Name" prefWidth="160" />
                  <TableColumn fx:id="colItemCat"   text="Category"  prefWidth="110" />
                  <TableColumn fx:id="colItemPrice" text="Price ($)" prefWidth="80"  />
               </columns>
            </TableView>

            <!-- Quantity, Notes, Add Button -->
            <HBox spacing="10.0" alignment="CENTER_LEFT">
               <Label text="Qty:" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
               <Spinner fx:id="qtySpinner" prefWidth="80" />
               <TextField fx:id="notesField" promptText="Special notes (e.g. extra spicy)"
                          HBox.hgrow="ALWAYS" styleClass="text-field" />
               <Button text="➕ Add to Order" styleClass="primary-button" onAction="#handleAddToOrder" />
            </HBox>
         </VBox>

         <!-- Right: Current Draft Order -->
         <VBox spacing="10.0" prefWidth="420.0"
               style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 16;
                      -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 6, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT">
               <Label text="🛒 Order Items"
                      style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
               <Region HBox.hgrow="ALWAYS" />
               <Button text="Clear" styleClass="secondary-button"
                       style="-fx-padding: 4 10; -fx-font-size: 11px;" onAction="#handleClearDraft" />
            </HBox>

            <TableView fx:id="draftTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colDraftItem"     text="Item"     prefWidth="140" />
                  <TableColumn fx:id="colDraftQty"      text="Qty"      prefWidth="50"  />
                  <TableColumn fx:id="colDraftNotes"    text="Notes"    prefWidth="100" />
                  <TableColumn fx:id="colDraftSubtotal" text="Subtotal" prefWidth="80"  />
               </columns>
            </TableView>

            <HBox spacing="8.0">
               <Button text="🗑️ Remove Selected" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                       styleClass="secondary-button" onAction="#handleRemoveDraftItem" />
            </HBox>

            <!-- Total Bar -->
            <HBox alignment="CENTER_LEFT"
                  style="-fx-background-color: #f8f9fa; -fx-padding: 10 14; -fx-background-radius: 8;">
               <Label text="Total Cost:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
               <Region HBox.hgrow="ALWAYS" />
               <Label fx:id="totalCostLabel" text="\$0.00"
                      style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #e67e22;" />
            </HBox>

            <!-- Place Order Button -->
            <Button text="✅ Confirm &amp; Place Order" maxWidth="Infinity"
                    styleClass="primary-button" style="-fx-pref-height: 42px; -fx-font-size: 14px;"
                    onAction="#handlePlaceOrder" />

            <Label fx:id="feedbackLabel" wrapText="true"
                   style="-fx-font-size: 12px; -fx-font-weight: bold;" />
         </VBox>

      </HBox>

   </children>
</VBox>
