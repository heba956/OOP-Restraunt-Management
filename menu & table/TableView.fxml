<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.controllers.TableController"
            stylesheets="@table.css">

    <top>
        <VBox spacing="12" style="-fx-padding: 20;">

            <Label text="Table Browsing"
                   styleClass="title"/>

            <HBox spacing="15">

                <Label text="Location:"/>

                <ComboBox fx:id="locationFilter"
                          promptText="All Locations"
                          prefWidth="150"/>

                <Label text="Capacity:"/>

                <ComboBox fx:id="capacityFilter"
                          promptText="All Capacities"
                          prefWidth="150"/>

                <Label text="Time Slot:"/>

                <ComboBox fx:id="timeFilter"
                          promptText="All Time Slots"
                          prefWidth="150"/>

                <Button fx:id="filterButton"
                        text="Filter"
                        onAction="#filterTables"/>

            </HBox>

        </VBox>
    </top>

    <center>
        <TableView fx:id="tableView">

            <columns>

                <TableColumn fx:id="numberColumn"
                             text="Table"
                             prefWidth="100"/>

                <TableColumn fx:id="capacityColumn"
                             text="Capacity"
                             prefWidth="120"/>

                <TableColumn fx:id="locationColumn"
                             text="Location"
                             prefWidth="150"/>

                <TableColumn fx:id="statusColumn"
                             text="Status"
                             prefWidth="150"/>
                
                <TableColumn fx:id="timeColumn"
                             text="Time Slot"
                             prefWidth="130"/>

            </columns>

        </TableView>
    </center>

    <bottom>
        <HBox spacing="15"
              alignment="CENTER_RIGHT"
              style="-fx-padding: 15;">

            <Label fx:id="feedbackLabel"
                   styleClass="feedback"/>

            <Button fx:id="backButton"
                    text="Back"/>

        </HBox>
    </bottom>

</BorderPane>